# ===== שרת =====
PORT=8484

# ===== טלוויזיית LG (webOS) =====
# כתובת ה-IP של הטלוויזיה ברשת הביתית (מומלץ לקבע אותה בראוטר)
LG_TV_IP=192.168.1.50
# כתובת ה-MAC של הטלוויזיה (נדרש להדלקה מרחוק דרך Wake-on-LAN). פורמט: AA:BB:CC:DD:EE:FF
LG_TV_MAC=
# מפתח הצימוד נשמר אוטומטית בקובץ data/lg-client-key.txt אחרי האישור הראשון בטלוויזיה

# ===== מזגן =====
# אחד מ: sensibo | broadlink | http | mock
AC_ADAPTER=mock

# --- Sensibo (ענן, הכי פשוט) ---
# מפתח API מתוך https://home.sensibo.com/me/api
SENSIBO_API_KEY=
# מזהה המכשיר (אם ריק, השרת יבחר את המכשיר הראשון בחשבון)
SENSIBO_DEVICE_ID=

# --- Broadlink RM Mini / RM4 (שלט IR ברשת) ---
BROADLINK_IP=192.168.1.60
BROADLINK_MAC=
# הקודים נלמדים דרך /api/ac/learn ונשמרים ב-data/ac-ir-codes.json

# --- גשר HTTP כללי (ESPHome / Tasmota / Switcher / כל דבר שמקבל HTTP) ---
# {state} יוחלף ב-JSON של מצב המזגן, {cmd} בשם הפקודה
AC_HTTP_URL=http://192.168.1.70/ac?cmd={cmd}
