# ===== שרת =====
PORT=8484

# ===== טלוויזיית LG (webOS) =====
# כתובת ה-IP של הטלוויזיה ברשת הביתית (מומלץ לקבע אותה בראוטר)
LG_TV_IP=192.168.1.50
# כתובת ה-MAC של הטלוויזיה (נדרש להדלקה מרחוק דרך Wake-on-LAN). פורמט: AA:BB:CC:DD:EE:FF
LG_TV_MAC=
# מפתח הצימוד נשמר אוטומטית בקובץ data/lg-client-key.txt אחרי האישור הראשון בטלוויזיה

# ===== אורות =====
# אחד או יותר, מופרדים בפסיק: hue | shelly | ha | mock
LIGHTS_ADAPTERS=mock

# --- Philips Hue (גשר מקומי) ---
# כתובת הגשר (באפליקציית Hue: הגדרות → גשרים → i, או https://discovery.meethue.com)
HUE_BRIDGE_IP=192.168.1.40
# צימוד: לוחצים על הכפתור בגשר ואז על "צמד" בממשק. נשמר ב-data/hue-username.txt

# --- Shelly (מתגים/דימרים מאחורי המפסק) ---
# פורמט לכל מכשיר: ip|חדר  או  ip|חדר:שם   (מופרדים בפסיק)
SHELLY_DEVICES=192.168.1.80|סלון,192.168.1.81|מטבח:אי

# --- Home Assistant (מכסה כל מה שכבר מחובר ל-HA: Tuya, Switcher, Sonoff, Zigbee...) ---
HA_URL=http://homeassistant.local:8123
# פרופיל → אבטחה → Long-Lived Access Tokens → צור
HA_TOKEN=
# אילו דומיינים להציג (ברירת מחדל light). להוסיף מתגים: light,switch
HA_DOMAINS=light
# אופציונלי: רק ישויות מסוימות, בסדר הזה
HA_ENTITIES=
